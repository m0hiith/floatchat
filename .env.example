# FloatChat -- every environment variable the code actually reads.
#
# Copy to `.env.local` for local overrides, or paste the names into the
# hosting platform's environment settings.  There are no values here and there
# never should be: `.gitignore` excludes every other `.env*` precisely because
# `vercel link` once put an OIDC token in one (D15.12).
#
# `api/test_deploy.py` compares this file against every `os.environ` read under
# `api/` and `etl/`, so a variable added to the code and not to this file is a
# failed check rather than a missing setting discovered during a demo (D17.4).

# ---------------------------------------------------------------------------
# The database.  The one variable a deployment cannot work without.
# ---------------------------------------------------------------------------
# Unset, the API falls back to the local development database, which on a
# hosted platform means "connection refused" -- reported honestly as a 503 that
# names the address it tried, but no ARGO question is answered.
#
# Use the POOLED connection string your provider offers, not the direct one.
# `catalog.connect()` opens a connection per query and a serverless function is
# a process per invocation, so a direct 5432 endpoint exhausts its connection
# limit under concurrency (D15.10, D17.5).  On Supabase that is the transaction
# pooler on port 6543; on Neon it is the `-pooler` host.
#
# The role must be the read-only one.  The entire safety argument in
# api/catalog.py assumes SELECT and nothing else, and nothing in the code can
# check what this string contains -- api/test_catalog.py can, against the live
# deployment, and that is a manual step (D15.2).
FLOATCHAT_DSN=postgresql://floatchat_ro:CHANGE_ME@HOST:6543/postgres?sslmode=require

# ---------------------------------------------------------------------------
# CORS.  Required as soon as the dashboard is not on localhost.
# ---------------------------------------------------------------------------
# Comma-separated, full origins WITH the scheme and no trailing path.
# `*` raises at import rather than being honoured, and an entry without a
# scheme raises too -- CORS matches by exact string, so `example.vercel.app`
# would match nothing and fail in a browser console instead of here (D15.3).
# The two localhost dev origins are always allowed and need not be listed.
# Vercel gives every PREVIEW deployment its own hostname; a preview dashboard
# is not in this list and cannot call the API.  Demo from the production alias.
FLOATCHAT_ORIGINS=https://your-dashboard.vercel.app

# ---------------------------------------------------------------------------
# The model path.  Entirely optional -- the dashboard needs none of it.
# ---------------------------------------------------------------------------
# The deployed dashboard sends `provider: "lexical"` on every request and is
# badged `no model`, so a key set here changes nothing it shows (D16.8).  What
# a key does change: `POST /ask` with an explicit provider, and `api/chat.py`.
#
# D15.5 warned that a key here would leave the query-time embedder mismatched
# against the shipped index.  It does not: `retrieval.load()` rebuilds the
# embedder from the index's own manifest, so the index is always searched with
# the embedder that built it.  Checked with a key in the environment, and
# corrected in D17.10.  To USE a Gemini embedder, rebuild the index with the
# key set -- setting the key alone changes nothing about retrieval.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Accepted alternatives to the two above, read by api/chat.py.  Set one form
# or the other, not both.
ANTHROPIC_AUTH_TOKEN=
GOOGLE_API_KEY=

# Overrides the Gemini model id.  Default: gemini-3.6-flash, which is the only
# tier the routing has ever been observed on (README, Known limitations).
GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Only read when the API is started by `python api/server.py`.
# ---------------------------------------------------------------------------
# Vercel imports the ASGI app and never runs that block, so these do nothing
# there.  They exist so a container host that injects PORT is not silently
# ignored (D17.6).  HOST defaults to 127.0.0.1; a container needs 0.0.0.0.
HOST=
PORT=
